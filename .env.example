# --- Telegram Bot ---
# Get this from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Your personal Telegram numeric user ID (get from @userinfobot).
# The bot ignores every user except this one.
OWNER_ID=123456789

# --- Webhook (Render Web Service) ---
# The public base URL Render assigns to this service, e.g.:
#   https://your-service-name.onrender.com
# No trailing slash.
WEBHOOK_URL=https://your-service-name.onrender.com

# Path segment Telegram will POST updates to. Keep the default unless you
# have a reason to change it.
WEBHOOK_PATH=/webhook

# Random secret string used to validate that incoming webhook requests are
# actually from Telegram (sent back as the X-Telegram-Bot-Api-Secret-Token
# header). Generate any long random string, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Database (Neon Postgres free tier) ---
# Create a free project at https://neon.tech, copy the connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Server ---
# Render sets this automatically; only needed for local testing.
PORT=10000

# --- Scratch chat ---
# A private GROUP where the bot is admin, used ONLY as a throwaway
# destination for reading captions via forwardMessage. Never post anything
# meaningful here -- the bot forwards a message in, reads it, then deletes
# it immediately.
#
# Setup:
#   1. Create a private group (not a channel).
#   2. Add the bot as a member, then promote it to admin.
#   3. Keep normal (non-anonymous) admin mode.
#   4. Ensure the bot's admin rights include "Delete Messages".
#   5. Forward any message from that group to @userinfobot to get its
#      chat_id (negative number, e.g. -1001234567890).
SCRATCH_CHAT_ID=-1001234567890
